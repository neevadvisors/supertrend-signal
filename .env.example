# Prefer backend/.env for the API (or keep credentials here; backend loads parent .env).
DHAN_CLIENT_ID=your_client_id
DHAN_PIN=your_6_digit_pin
DHAN_TOTP_SECRET=your_totp_secret_from_dhan_web
# Optional bootstrap until first TOTP mint (24h web token)
DHAN_ACCESS_TOKEN=
CORS_ORIGINS=http://localhost:3000
