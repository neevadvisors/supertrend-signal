{
  "name": "dhan-signals",
  "private": true,
  "scripts": {
    "start": "concurrently -k -n stack,web -c cyan,magenta \"docker compose up --build\" \"npm run wait:api && npm run dev:web\"",
    "up": "npm run start",
    "stop": "docker compose down",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "job": "docker compose run --rm api job",
    "wait:api": "node scripts/wait-for-api.mjs",
    "dev": "npm run start",
    "dev:api": ".venv/bin/uvicorn app.main:app --reload --host 0.0.0.0 --port 8000 --app-dir backend",
    "dev:web": "npm run dev --prefix frontend",
    "install:all": ".venv/bin/pip install -r backend/requirements.txt && npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
