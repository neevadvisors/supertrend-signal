# Copy to terraform.tfvars (gitignored) and fill in real values.
#   cp terraform.tfvars.example terraform.tfvars

region = "ap-south-1"

# Existing laptop public key only — Terraform never generates a private key.
ssh_public_key_path = "~/.ssh/neev_signals_aws.pub"

# Your current public IP as /32 (update + re-apply if it changes).
#   curl -s https://checkip.amazonaws.com
admin_cidr = "x.x.x.x/32"

# RDS master password — also ends up in local terraform.tfstate (do not commit state).
db_password = "change-me-strong-password"

# Optional overrides:
# project_name         = "neev-signals"
# instance_type        = "t3.small"
# root_volume_size_gb  = 30
# db_instance_class    = "db.t4g.micro"
# db_allocated_storage = 20
# db_name              = "signals"
# db_username          = "signals"
